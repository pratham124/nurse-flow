EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_GO_API_URL=http://127.0.0.1:8080
# Hosted development API (see docs/go-migration/hosted-development.md):
# EXPO_PUBLIC_GO_API_URL=https://nurseflow-api-dev-<project-number>.us-east4.run.app

# Push notifications are off by default. Set to "true" to restore the permission card, token registration and tap handling.
# EXPO_PUBLIC_NOTIFICATIONS_ENABLED=true
