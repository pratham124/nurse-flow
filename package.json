    "test:phase8-performance": "tsx --test tests/floorBoardLookup.test.mjs",
    "test:phase9-fixtures": "tsx --test tests/phase9OptimizerFixtures.test.mjs",
    "test:phase9-normalization": "python -m unittest discover -s optimizer-service/tests -p \"test_*.py\"",
    "test:phase9-optimizer": "optimizer-service\\.venv\\Scripts\\python.exe -m unittest discover -s optimizer-service/tests -p \"test_*.py\"",
    "test:phase9-output-compatibility": "tsx --test tests/phase9OutputCompatibility.integration.mjs",
    "test:phase9-mobile": "tsx --test tests/optimizerRepository.test.mjs tests/phase9MobileRuntime.test.mjs",
