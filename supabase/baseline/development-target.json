  "query": "BEGIN READ ONLY;\nSELECT jsonb_build_object(\n 'role',current_user,'version',current_setting('server_version'),\n 'relations',(SELECT coalesce(jsonb_agg(jsonb_build_object('name',c.relname,'kind',c.relkind,'owner',pg_get_userbyid(c.relowner))),'[]') FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p','v','m','S','f')),\n 'functions',(SELECT coalesce(jsonb_agg(jsonb_build_object('schema',n.nspname,'name',p.proname,'args',pg_get_function_identity_arguments(p.oid),'owner',pg_get_userbyid(p.proowner))),'[]') FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public' OR (n.nspname='auth' AND p.proname IN ('uid','role')) OR (n.nspname='extensions' AND p.proname='digest') OR (n.nspname='realtime' AND p.proname IN ('send','topic'))),\n 'auth_users',to_regclass('auth.users'),'realtime_messages',to_regclass('realtime.messages'),\n 'defaults',(SELECT coalesce(jsonb_agg(jsonb_build_object('owner',pg_get_userbyid(d.defaclrole),'schema',n.nspname,'type',d.defaclobjtype,'acl',d.defaclacl)),'[]') FROM pg_default_acl d LEFT JOIN pg_namespace n ON n.oid=d.defaclnamespace WHERE d.defaclnamespace=0 OR n.nspname='public'),\n 'schemas',(SELECT jsonb_agg(jsonb_build_object('name',nspname,'owner',pg_get_userbyid(nspowner),'acl',nspacl)) FROM pg_namespace WHERE nspname IN ('public','auth','realtime','extensions')),\n 'extensions',(SELECT jsonb_agg(jsonb_build_object('name',extname,'version',extversion,'schema',extnamespace::regnamespace)) FROM pg_extension),\n 'policies',(SELECT coalesce(jsonb_agg(to_jsonb(p)),'[]') FROM pg_policies p WHERE schemaname IN ('public','realtime')),\n 'publications',(SELECT coalesce(jsonb_agg(to_jsonb(p)),'[]') FROM pg_publication p),\n 'publication_tables',(SELECT coalesce(jsonb_agg(to_jsonb(p)),'[]') FROM pg_publication_tables p)\n) AS inspection;\nCOMMIT;"
