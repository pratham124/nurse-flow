  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:effective-assignment": "tsx --test tests/effectiveAssignment.test.mjs tests/assignmentMovePreview.test.mjs",
    "test:request-realtime": "tsx --test tests/realtimeWorkspaceRepository.test.mjs",
    "test:request-lifecycle": "tsx --test tests/nurseRequestLifecycle.test.mjs tests/notificationTap.test.mjs",
    "test:responsive-layout": "tsx --test tests/responsiveLayout.test.mjs",
